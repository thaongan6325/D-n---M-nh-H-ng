@model IEnumerable<Vivu_Xe.Models.Xe>

@{
    ViewData["Title"] = "Quản lý Đội xe";
}

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="m-0 font-weight-bold text-primary">
            <i class="fa-solid fa-car"></i> Danh sách Xe
        </h5>

        <a asp-action="Create"
           class="btn btn-primary btn-sm shadow-sm">
            <i class="fa-solid fa-plus"></i> Thêm xe mới
        </a>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light text-center">
                    <tr>
                        <th>Tên Xe</th>
                        <th>Biển Số</th>
                        <th>Hãng / Loại</th>
                        <th>Giá Thuê</th>
                        <th>Cọc</th>
                        <th>Trạng Thái</th>
                        <th width="150">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">
                                    @item.TenXe
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.BienSo
                                    </span>
                                </td>

                                <td>
                                    @(item.MaHangNavigation?.TenHang ?? "Chưa cập nhật")
                                    <br />

                                    <small class="text-muted">
                                        @(item.MaLoaiNavigation?.TenLoai ?? "Chưa cập nhật")
                                    </small>
                                </td>

                                <td class="text-end text-success fw-bold">
                                    @item.GiaThueNgay.ToString("N0") đ
                                </td>

                                <td class="text-end">
                                    @(item.TienCoc?.ToString("N0") ?? "0") đ
                                </td>

                                <td class="text-center">
                                    @if (item.TrangThai == "Sẵn sàng")
                                    {
                                        <span class="badge bg-success">
                                            <i class="fa-solid fa-check"></i>
                                            Sẵn sàng
                                        </span>
                                    }
                                    else if (item.TrangThai == "Đang thuê")
                                    {
                                        <span class="badge bg-primary">
                                            <i class="fa-solid fa-road"></i>
                                            Đang thuê
                                        </span>
                                    }
                                    else if (item.TrangThai == "Bảo dưỡng")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="fa-solid fa-wrench"></i>
                                            Bảo dưỡng
                                        </span>
                                    }
                                    else if (item.TrangThai == "Ngưng hoạt động")
                                    {
                                        <span class="badge bg-danger">
                                            <i class="fa-solid fa-ban"></i>
                                            Ngưng hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            <i class="fa-solid fa-circle-info"></i>
                                            @(item.TrangThai ?? "Chưa cập nhật")
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.MaXe"
                                       class="btn btn-warning btn-sm"
                                       title="Sửa">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.MaXe"
                                       class="btn btn-info btn-sm text-white"
                                       title="Chi tiết">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.MaXe"
                                       class="btn btn-danger btn-sm"
                                       title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">
                                Chưa có xe nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: '@Html.Raw(TempData["SuccessMessage"])',
                showConfirmButton: false,
                timer: 1800,
                timerProgressBar: true
            });
        </script>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'Không thể thực hiện',
                text: '@Html.Raw(TempData["ErrorMessage"])',
                confirmButtonText: 'Đóng',
                confirmButtonColor: '#d33'
            });
        </script>
    }
}