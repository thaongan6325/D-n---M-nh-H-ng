@model Vivu_Xe.Models.Xe

@{
    ViewData["Title"] = "Xóa xe";
}

<div class="container-fluid">

    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-danger">
            <i class="fas fa-trash-alt"></i> Xóa xe
        </h1>

        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card shadow">

        <div class="card-header bg-danger text-white">
            <h5 class="mb-0">
                Xác nhận xóa xe
            </h5>
        </div>

        <div class="card-body">

            

            <table class="table table-bordered">

                <tr>
                    <th width="30%">Tên xe</th>
                    <td>@Model.TenXe</td>
                </tr>

                <tr>
                    <th>Biển số</th>
                    <td>@Model.BienSo</td>
                </tr>

                <tr>
                    <th>Hãng xe</th>
                    <td>@Model.MaHangNavigation?.TenHang</td>
                </tr>

                <tr>
                    <th>Loại xe</th>
                    <td>@Model.MaLoaiNavigation?.TenLoai</td>
                </tr>

                <tr>
                    <th>Màu sắc</th>
                    <td>@Model.MauSac</td>
                </tr>

                <tr>
                    <th>Năm sản xuất</th>
                    <td>@Model.NamSanXuat</td>
                </tr>

                <tr>
                    <th>Hộp số</th>
                    <td>@Model.HopSo</td>
                </tr>

                <tr>
                    <th>Nhiên liệu</th>
                    <td>@Model.NhienLieu</td>
                </tr>

                <tr>
                    <th>Giá thuê / ngày</th>
                    <td class="text-success fw-bold">
                        @Model.GiaThueNgay.ToString("N0") đ
                    </td>
                </tr>

                <tr>
                    <th>Tiền cọc</th>
                    <td class="text-danger fw-bold">
                        @Model.TienCoc?.ToString("N0") đ
                    </td>
                </tr>

                <tr>
                    <th>Mô tả</th>
                    <td>@Model.MoTa</td>
                </tr>

                <tr>
                    <th>Trạng thái</th>
                    <td>@Model.TrangThai</td>
                </tr>

            </table>

            <form asp-action="Delete">
                <input type="hidden" asp-for="MaXe" />

                <div class="text-center mt-4">

                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-trash"></i> Xóa xe
                    </button>

                    <a asp-action="Index" class="btn btn-secondary px-4">
                        <i class="fas fa-times"></i> Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>